# AgentEval Lab LLM 配置（OpenAI 兼容协议）
# 使用方法：cp .env.example .env，然后填入真实 Key。.env 已在 .gitignore 中，切勿提交。
#
# 默认 MiniMax；换成任何 OpenAI 兼容服务（DeepSeek/Qwen/...）只需改这三行。
# 无 Key 也可以完整演示：python3 -m agenteval.cli run --target mock:good

LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M1

# Judge 可单独用模型；留空则复用上面的 LLM_* 配置
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# HTTP Target 示例：外部 Agent API 的密钥可被 configs 中的 ${HTTP_AGENT_TOKEN} 引用
HTTP_AGENT_TOKEN=
